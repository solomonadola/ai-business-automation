# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_business_automation

# Webhook & Workflow Orchestration Configuration
WEBHOOK_SECRET=dev-webhook-secret-change-in-production
N8N_WEBHOOK_URL=http://localhost:5678/webhook/leads

# AI Classification Configuration
# LLM_PROVIDER=mock            # mock (deterministic, no API key) | openai
# OPENAI_API_KEY=              # required when LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# Free providers work via the same OpenAI-compatible adapter — just override
# OPENAI_BASE_URL + OPENAI_MODEL. Examples:
#
# Google Gemini (free tier): https://aistudio.google.com/app/apikey
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=AIza...your-gemini-key
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_MODEL=gemini-flash-lite-latest
#
# Groq (free tier): https://console.groq.com/keys
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
#
# Ollama (local, offline): http://localhost:11434
#   OPENAI_API_KEY=ollama
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=llama3.2

# Notification Configuration
# NOTIFICATION_PROVIDER=in-memory   # in-memory (no side effects) | webhook
